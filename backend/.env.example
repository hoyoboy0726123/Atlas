# 複製此檔案為 .env 並填入你的 API Key
# cp .env.example .env

# ── API Keys ──────────────────────────────────────────────────
# 全部可以留空:第一次在首頁送出訊息時,Atlas 會顯示設定指引,
# 在那裡貼上 Gemini API Key 就會自動寫進這個檔案,不需要手動編輯。

# Google Gemini(預設,模型 gemini-3.5-flash-lite)
# 申請:https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — Llama 4 Scout / Llama 3.3 70B 等
# 申請:https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI — GPT-5 / GPT-5-mini / o3 等
# 申請:https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — Claude Sonnet 4.x / Opus 4.x
# 申請:https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenRouter — 一把 key 打多家、含免費模型(目前 codebase 已移除直接走 OpenRouter、
# 此 key 給 web_search Tavily fallback 或日後想接回來用)
# 申請:https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Telegram(選填、也可透過 Web UI 設定)────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 其他 ──────────────────────────────────────────────────────
TIMEZONE=Asia/Taipei

# 遠端 MCP server 防呆閘(選填):設了之後,在設定頁新增「遠端 HTTP/SSE」MCP server
# 必須輸入這個密碼才放行 —— 攔「隨手貼網路上遠端 URL」的無腦操作。
# ⚠ 這是防手滑的摩擦、不是存取控制(密碼在此明文、能讀檔者可繞);留空 = 不啟用、只靠介面的信任勾選。
ATLAS_REMOTE_MCP_PASSWORD=

# ⚠ 進階 / 通常不必設(看下面註解):
#   OUTPUT_BASE_PATH:workflow 產物落地的根目錄。沒設 = 預設 <repo_root>/ai_output、
#     系統各模組(runner / chat_tools / send_file_to_tg)會自動對齊、不必設。
#     僅在「想把產物外放到其他磁碟」這種特殊情境才設絕對路徑(例:OUTPUT_BASE_PATH=D:/work_outputs)。
#     **不要設相對路徑** — 容易跟 hardcoded 路徑撞掉,造成 workflow 找不到自己產物。
# OUTPUT_BASE_PATH=
#   PIPELINE_DIR:workflow YAML 檔案位置(現在已遷移到 sqlite db、這個變數已棄用、忽略即可)。
# PIPELINE_DIR=~/pipelines

# ── Claude 訂閱 CLI 大腦(provider=claude_cli 時才用得到)──────────
# 訂閱有「共享 rate window」:多個 skill / subagent 同時 spawn CLI 會自己
# DDoS 自己的額度。這個值限制同時併發的 CLI 行程數,預設 2。
# 調高會更快但更容易撞額度上限;調低更保守。
CLAUDE_CLI_MAX_CONCURRENT=2
